# Source of truth for LLM config. Empty agent model -> DEFAULT_MODEL. Empty API_KEY -> the provider's own env var (e.g. ANTHROPIC_API_KEY).
PROVIDER=bedrock_converse
API_KEY=
DEFAULT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
HYPOTHESIS_MODEL=
SUPERVISOR_MODEL=
RESEARCHER_MODEL=
REFLECTION_MODEL=
MEMORY_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
DAILY_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
INTRADAY_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS Bedrock (the hackathon stack). Paste the three access keys from the AWS access portal
# (Sandbox account > Access keys). They expire every 12 hours: log in again and paste fresh ones.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Or leave the three keys empty and use the SSO profile from the training: aws sso login --profile hackathon
AWS_PROFILE=
# Optional: the owner's Google Calendar (see agent/Agent_architecture/navigation_team/CALENDAR_SETUP.md)
GOOGLE_OAUTH_CREDENTIALS=
VIBE_CALENDAR=
